# Copy to .env next to where you run kilazi-live. Everything is optional.

# Your OpenAI key: transcription (and the default copilot). Or paste it in the page instead.
OPENAI_API_KEY=

# Copilot: openai (default) | claude (Claude Code CLI on this machine) | codex (Codex CLI) | http (your own endpoint)
COPILOT_PROVIDER=openai
COPILOT_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Any model behind a token: POST {system, prompt, transcript} -> {"text": "..."} or plain text
COPILOT_HTTP_URL=
COPILOT_HTTP_TOKEN=

# Hand out codes instead of keys: code=provider, comma separated. Guests then use OPENAI_API_KEY above.
# ACCESS_CODES=pick-a-long-random-code=openai,another-long-random-code=claude
CODE_DAILY_MINUTES=120

PORT=4321
HOST=127.0.0.1
NOTES_DIR=kilazi-live-notes
